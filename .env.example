# Production origin for canonicals, social metadata and sitemaps. No trailing slash.
SITE_URL=https://www.adsquirrel.in

# Which location pages are offered to search engines (all of them still render for visitors).
# official: government-listed settlements plus cities, towns, census towns and suburbs (~2,200).
# extended: also community-mapped villages, localities and quarters (~5,700). Their pages share
# most of their wording, so switch only after adding genuinely local content to them.
PLACE_INDEX_TIER=official

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to ship no analytics.
# Loaded after the page is idle; enquiry clicks are sent as generate_lead events.
PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (the content value only).
# Not needed if the domain is verified through DNS.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Vercel production: true enables every valid place × industry URL on demand,
# with a 24-hour ISR cache and lazy sitemap chunks. Static Sites preview: false.
# This serves all combinations without writing one million HTML files.
SSR_COMBINATIONS=false

# Default: every place and industry page plus a selected set of combinations.
# Full combinations need explicit opt-in, enough deployment capacity and a content
# review. The build stops rather than silently exceeding the configured budget.
# These offline-generation options apply only when SSR_COMBINATIONS=false.
GENERATE_ALL_COMBINATIONS=false
MAX_COMBINATION_PAGES=50000

