---
import SiteLayout from './SiteLayout.astro';
import Icon from './Icon.astro';
import ContactSection from './ContactSection.astro';
import { industriesBySlug, combinationKeys, servicePlaces, getNearbyServicePlaces, officeDistanceKm } from '../lib/catalog.mjs';
import { localNotes } from '../lib/local.mjs';
import { services, servicePath, getServiceMeta, getServiceFaqs, getServiceStructuredData, placeAlternates, placeMalayalam, placeLabel } from '../lib/services.mjs';
const { service, place } = Astro.props;
const meta = getServiceMeta(service, place);
const area = place ? placeLabel(place) : 'Thrissur & Ernakulam';
const district = place?.district || 'Kerala';
const alternates = place ? placeAlternates(place) : [];
const malayalamName = place ? placeMalayalam(place) : 'തൃശ്ശൂർ, എറണാകുളം';
const distance = place ? officeDistanceKm(place) : undefined;
const localNote = place ? localNotes[place.slug] : undefined;
const faqs = getServiceFaqs(service, place);
const otherServices = services.filter((item) => item.slug !== service.slug);
const nearby = place ? getNearbyServicePlaces(place) : [];
const industryLinks = service.industries.map((slug) => industriesBySlug.get(slug)).filter(Boolean).map((industry) => ({ industry, href: place && combinationKeys.has(`${place.slug}/${industry.slug}`) ? `/locations/${place.slug}/${industry.slug}/` : `/industries/${industry.slug}/` }));
const placesByDistrict = ['Thrissur', 'Ernakulam'].map((name) => ({ name, places: servicePlaces.filter((item) => item.district === name).sort((a, b) => (a.type === 'district' ? -1 : b.type === 'district' ? 1 : a.name.localeCompare(b.name))) }));
---
<SiteLayout title={meta.title} description={meta.description} canonical={meta.canonical} schema={getServiceStructuredData(service, place)} heroPlace={place ? placeLabel(place) : ''}>
  <main id="main">
    <div class="directory-page service-intro">
      <nav class="service-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/services/">Services</a> / {place ? <><a href={servicePath(service)}>{service.title}</a> / <span>{area}</span></> : <span>{service.title}</span>}</nav>
      <div class="directory-intro">
        <p class="eyebrow">{service.short.toUpperCase()} · {district.toUpperCase()}</p>
        <h1>{service.title} in {area}</h1>
        <p>{service.lead(place ? area : 'Thrissur and Ernakulam', district)}</p>
        <p>Also searched as {service.alsoCalled.join(', ')}.{alternates.length > 0 && ` ${place.name} is also written as ${alternates.join(', ')}.`}</p>
        {malayalamName && <p lang="ml">{malayalamName} · {service.ml}. ഞങ്ങളോട് മലയാളത്തിലും സംസാരിക്കാം.</p>}
      </div>
      <div class="hero-actions"><a class="button button-dark" href="#contact">Talk to us about {service.name} <Icon size={18} /></a>{place && <a class="text-link" href={`/locations/${place.slug}/`}>Digital marketing in {place.name} <Icon size={16} /></a>}</div>
    </div>
    <section class="place-context section-shell">
      <div><span class="eyebrow">WHAT’S INCLUDED</span><h2>{service.name} for businesses in <span class="serif-word">{place ? place.name : area}.</span></h2><ul class="service-list">{service.includes.map((item) => <li><Icon name="check" size={16} />{item}</li>)}</ul><h3>What it costs</h3><p>{service.cost}</p></div>
      <div class="place-brief"><span class="eyebrow">HOW WE WORK</span><ol>{service.steps.map((step) => <li><strong>{step}.</strong></li>)}</ol><p>{place ? `${area} is in ${district} district${distance !== undefined ? `, ${distance < 3 ? 'close to' : `about ${Math.round(distance)} km by straight line from`} our office at Kinfra Hi-Tech Park, Kalamassery` : ''}. We work with businesses here through calls, WhatsApp and planned visits.` : 'Our office is at Kinfra Hi-Tech Park, Kalamassery. We work with businesses across Thrissur and Ernakulam districts through calls, WhatsApp and planned visits.'}</p>{localNote && <><h3>{service.name} in {place.name}: local context</h3><p>{localNote.about}</p><p>{localNote.marketing}</p></>}</div>
    </section>
    <section class="section-shell service-section">
      <div class="context-panel"><span class="eyebrow">WHO IT SUITS</span><h3>{service.name} for local businesses{place ? ` in ${place.name}` : ''}</h3><div class="place-chips">{industryLinks.map(({ industry, href }) => <a href={href}>{industry.name}<span>↗</span></a>)}</div></div>
    </section>
    {place ? (
      <section class="place-context section-shell">
        <div><span class="eyebrow">MORE IN {place.name.toUpperCase()}</span><h3>Other services in {place.name}</h3><div class="place-chips"><a href={`/locations/${place.slug}/`}>Digital marketing agency<span>↗</span></a>{otherServices.map((item) => <a href={servicePath(item, place)}>{item.title}<span>↗</span></a>)}</div></div>
        {nearby.length > 0 && <div><span class="eyebrow">NEARBY</span><h3>{service.title} near {place.name}</h3><div class="place-chips">{nearby.map((item) => <a href={servicePath(service, item)}>{item.name}<span>↗</span></a>)}</div><a class="inline-link" href={servicePath(service)}>All areas for {service.name} <Icon size={16} /></a></div>}
      </section>
    ) : (
      <section class="place-context section-shell">
        {placesByDistrict.map((group) => <div><span class="eyebrow">{group.name.toUpperCase()} DISTRICT</span><h3>{service.title} in {group.name}</h3><div class="place-chips">{group.places.map((item) => <a href={servicePath(service, item)}>{placeLabel(item)}<span>↗</span></a>)}</div></div>)}
      </section>
    )}
    <section class="faq-section section-shell" id="faq"><div><span class="eyebrow">A FEW ANSWERS</span><h2>{service.name} in {place ? place.name : area}: <span class="serif-word">your questions.</span></h2><p>Straight answers before you spend anything.</p></div><div class="faq-items">{faqs.map((faq) => <details name="faq"><summary>{faq.question}<span class="faq-plus">+</span></summary><p>{faq.answer}</p></details>)}</div></section>
    <ContactSection />
  </main>
</SiteLayout>
