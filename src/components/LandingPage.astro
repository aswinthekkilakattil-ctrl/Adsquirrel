---
import SiteLayout from './SiteLayout.astro';
import Icon from './Icon.astro';
import ContactSection from './ContactSection.astro';
import HeroGrowth from './HeroGrowth.astro';
import KeralaMap from './KeralaMap.astro';
import '../styles/hero-art.css';
import { getFaqs } from '../lib/site.mjs';
import { places, industries, getRelatedPlaces, servicePlaceSlugs, officeDistanceKm, combinationKeys } from '../lib/catalog.mjs';
import { localNotes } from '../lib/local.mjs';
import { services, servicePath } from '../lib/services.mjs';
const { place, industry, noindex = false, canonical } = Astro.props;
const area = place ? `${place.name}${place.type === 'district' ? ' district' : ''}` : 'Kerala';
const relatedPlaces = place ? getRelatedPlaces(place, 8) : [];
const placeServices = place && !industry && servicePlaceSlugs.has(place.slug) ? services : [];
const localNote = place && !industry ? localNotes[place.slug] : undefined;
const localIndustries = (localNote?.industries || []).map(slug => industries.find(i => i.slug === slug)).filter(Boolean).map(item => ({ industry: item, href: combinationKeys.has(`${place.slug}/${item.slug}`) ? `/locations/${place.slug}/${item.slug}/` : `/industries/${item.slug}/` }));
const officeKm = place ? officeDistanceKm(place) : undefined;
const placeFacts = place ? [
  place.taluk && place.type !== 'taluk' && `It falls in ${place.taluk} taluk.`,
  place.officialName && place.officialName !== place.name && `Its official name is ${place.officialName}.`,
  officeKm !== undefined && (officeKm < 3 ? 'It is close to our office at Kinfra Hi-Tech Park, Kalamassery.' : `It is about ${Math.round(officeKm)} km in a straight line from our office in Kalamassery.`),
].filter(Boolean).join(' ') : '';
const faqs = getFaqs({ place, industry });
const selectedIndustries = ['healthcare', 'real-estate', 'hospitality', 'education', 'retail', 'restaurants'];
const featuredIndustries = selectedIndustries.map(slug => industries.find(i => i.slug === slug)).filter(Boolean);
const industryLinks = featuredIndustries.length >= 4 ? featuredIndustries : industries.slice(0, 6);
const featuredPlaces = ['Kochi','Thiruvananthapuram','Kozhikode','Thrissur','Kollam','Kannur','Kottayam','Alappuzha','Kalamassery'].map(name => places.find(p => p.name.toLowerCase() === name.toLowerCase())).filter(Boolean);
const cards = [
  {id:'01',icon:'search',title:'Search & answer visibility',text:'Show up where decisions begin. Technical SEO, local search and clear, useful answers for people and AI search.',tags:'SEO · LOCAL SEO · AEO',color:'lavender'},
  {id:'02',icon:'chart',title:'Performance marketing',text:'Turn the right attention into action. Google and Meta campaigns with considered creative and clear measurement.',tags:'GOOGLE ADS · META ADS',color:'peach'},
  {id:'03',icon:'sparkle',title:'Brand & social',text:'Give people a reason to remember you. A distinctive identity, a consistent voice and content that earns its place.',tags:'BRANDING · SOCIAL · CONTENT',color:'green'},
  {id:'04',icon:'globe',title:'Websites that work',text:'Make that first click count. Fast, intuitive websites that connect a good customer experience to your business goals.',tags:'WEB DESIGN · DEVELOPMENT',color:'blue'},
];
---
<SiteLayout {place} {industry} {noindex} {canonical}>
  <main id="main">
    <section class="hero hero--flow" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow hero-eyebrow">adsquirrel, the best</div>
        <h1 id="hero-title">Digital marketing<br class="desktop-break" /> agency in <span class="hero-place" data-location-name>{area}<svg viewBox="0 0 400 17" preserveAspectRatio="none" aria-hidden="true"><path d="M3 11C90 1 265 1 397 8M40 15C140 7 285 5 355 13" /></svg></span><span class="heading-dot">.</span></h1>
        <p class="hero-description">A little strategy. A lot of possibility. We bring together creativity, search and performance to help your business grow beyond the ordinary.</p>
        <div class="hero-actions"><a class="button button-dark" href="#contact">Let’s grow your business <Icon size={18} /></a><a class="text-link" href="#services">Explore our services <Icon name="down" size={16} /></a></div>
      </div>
      <HeroGrowth />
    </section>
    <section class="intent-strip section-shell" aria-label="Find marketing for your business">
      <div class="intent-intro"><span class="tiny-star">✳</span><p>Your business.<br /><strong>Your kind of growth.</strong></p></div>
      <form id="intent-form" class="intent-form">
        <label><span>WHERE YOU ARE</span><div class="input-with-icon"><Icon name="pin" size={17}/><input id="location-input" name="location" list="location-options" placeholder="Choose your location" autocomplete="off" value={place ? (place.type === 'district' ? `${place.name} district` : `${place.name}, ${place.district}`) : ''} /><datalist id="location-options"></datalist></div></label>
        <label><span>WHAT YOU DO</span><div class="input-with-icon"><Icon name="globe" size={17}/><input id="industry-input" name="industry" list="industry-options" placeholder="Choose your industry" autocomplete="off" value={industry?.name || ''} /><datalist id="industry-options"></datalist></div></label>
        <button class="intent-submit" type="submit" aria-label="Explore marketing for your location and industry"><Icon name="arrow" size={24} /></button>
      </form>
      <p id="intent-status" class="form-status" role="status" aria-live="polite"></p>
    </section>
    <section class="intro-section section-shell" id="about">
      <span class="eyebrow section-label"><span class="mini-line"></span> THE RIGHT KIND OF DIFFERENT</span>
      <div><h2 data-industry-heading>{industry ? `Digital marketing for ${industry.name.toLowerCase()} businesses.` : <>Good businesses<br />deserve to be <span class="serif-word">found.</span></>}</h2><p data-industry-description>{industry?.description || 'You know your business. We know how to get the right people to notice it. From the first search to the next enquiry, we connect the dots between your brand and your next customer.'}</p><a href="#contact" class="inline-link">Find your next move <Icon size={18}/></a></div>
    </section>
    <section id="services" class="services-section section-shell">
      <div class="section-heading"><div><span class="eyebrow">WHAT WE DO</span><h2>Small details.<br />Bigger <span class="serif-word">impact.</span></h2></div><p>One connected approach. From getting discovered<br class="desktop-break" /> to becoming someone’s first choice.</p></div>
      <div class="services-grid">{cards.map(card => <a class={`service-card ${card.color}`} href={`#contact`}><div class="card-top"><Icon name={card.icon} size={30}/><span>{card.id}</span></div><div><h3>{card.title}</h3><p>{card.text}</p></div><div class="card-bottom"><span>{card.tags}</span><span class="circle-arrow"><Icon size={18}/></span></div></a>)}</div>
      <a class="inline-link" href="/services/">Meta ads, Google Ads, SEO and more across Thrissur and Ernakulam <Icon size={18}/></a>
    </section>
    <section class="approach-section" id="approach"><div class="section-shell approach-inner"><div class="approach-copy"><span class="eyebrow">OUR APPROACH</span><h2>Less guesswork.<br />More <span class="serif-word">going places.</span></h2><p>Every business has a different starting point. We take the time to understand yours, then build a plan that makes sense for your customers, your market and your ambitions.</p><a class="button button-lime" href="#contact">Find your starting point <Icon size={18}/></a></div><ol class="approach-steps"><li><span>01</span><div><h3>Get curious.</h3><p>Listen first. Understand your business, your customers and what’s getting in the way.</p></div><Icon name="plus" size={18}/></li><li><span>02</span><div><h3>Connect the dots.</h3><p>Bring strategy, creative and the right channels together in one practical plan.</p></div><Icon name="plus" size={18}/></li><li><span>03</span><div><h3>Make the next move.</h3><p>Launch, measure and learn. Keep improving the things that make a difference.</p></div><Icon name="plus" size={18}/></li></ol></div></section>
    {!localNote && <section class="industry-section section-shell" id="industries"><div class="section-heading"><div><span class="eyebrow">WHO WE HELP</span><h2>Your world.<br />Our <span class="serif-word">next brief.</span></h2></div><p>A neighbourhood favourite or an ambitious new name.<br />We start with what makes your business yours.</p></div><div class="industry-links">{industryLinks.map((item,i) => <a href={`/industries/${item.slug}/`}><span class="industry-index">0{i+1}</span><h3>{item.name}</h3><Icon size={22}/></a>)}</div><a class="inline-link" href="/industries/">Find your industry <Icon size={18}/></a>{industry && <div class="context-panel"><span class="eyebrow">A PLAN FOR YOUR BUSINESS</span><h3>{industry.name}: start with your customer’s next decision.</h3><p>{industry.audience}</p><ul>{industry.services.map(service => <li><Icon name="check" size={16}/>{service}</li>)}</ul></div>}</section>}
    <section class="local-section section-shell" id="locations"><KeralaMap /><div class="local-copy"><span class="eyebrow">CLOSE TO HOME. OPEN TO POSSIBILITY.</span><h2>From your street<br />to their <span class="serif-word">screen.</span></h2><p>{place ? `Looking for a digital marketing agency serving ${place.name}? Our team works from Kalamassery, supporting businesses across ${place.district} and Kerala through remote collaboration and planned meetings.` : 'From growing cities to neighbourhood businesses, good ideas belong everywhere. We work with businesses across Kerala, with the local understanding to make your message feel at home.'}</p><div class="place-chips">{featuredPlaces.map(item => <a href={`/locations/${item.slug}/`}>{item.name}<span>↗</span></a>)}</div><a class="inline-link" href="/locations/">Explore every listed location <Icon size={18}/></a><p class="local-disclosure">Listed locations represent the areas we serve.</p></div></section>
    {place && <section class="place-context section-shell"><div><span class="eyebrow">YOUR LOCATION, IN CONTEXT</span><h2>Marketing that starts<br />with <span class="serif-word">{place.name}.</span></h2><p>{place.name} is listed in our sourced Kerala directory as a {place.type.replaceAll('_',' ')}{place.type !== 'district' ? ` in ${place.district} district` : ''}.  {placeFacts} For your business, we start by checking how your customers search for your services here, then agree on the areas you actually serve.</p>{localNote && <><h3>What {place.name} is known for</h3><p>{localNote.about}</p><h3>What the local economy runs on</h3><p>{localNote.economy}</p><h3>What it means for marketing</h3><p>{localNote.marketing}</p></>}{place.aliases?.length > 0 && <p class="place-aliases">Also recorded as: {place.aliases.join(' · ')}.</p>}<a class="inline-link" href="/data-sources/">About our location data <Icon size={16}/></a></div><div class="place-brief">{localNote && <><span class="eyebrow">KEY MOMENTS IN {place.name.toUpperCase()}</span><ul class="service-list">{localNote.seasons.map(season => <li><Icon name="check" size={16}/>{season}</li>)}</ul><h3>Businesses we help in {place.name}</h3><div class="place-chips">{localIndustries.map(({ industry, href }) => <a href={href}>{industry.name}<span>↗</span></a>)}</div></>}{!localNote && <><span class="eyebrow">YOUR LOCAL MARKETING STARTING POINT</span><ol><li><strong>Make your service area clear.</strong> Publish accurate business details, opening hours and the areas you can realistically serve.</li><li><strong>Answer the next question.</strong> Explain your services, process and enquiry options in the languages your customers use.</li><li><strong>Measure real enquiries.</strong> Connect calls, messages and form submissions to the campaigns that brought them.</li></ol></>}{placeServices.length > 0 && <><h3>Services in {place.name}</h3><div class="place-chips">{placeServices.map(service=><a href={servicePath(service, place)}>{service.title}<span>↗</span></a>)}</div></>}{relatedPlaces.length > 0 && <><h3>Explore more of {place.district}</h3><div class="place-chips">{relatedPlaces.map(item=><a href={`/locations/${item.slug}/`}>{item.name}<span>↗</span></a>)}</div></>}</div></section>}
    {!localNote && <section class="testimonial-section section-shell"><div><span class="eyebrow">THE KIND OF PARTNERSHIP WE AIM FOR</span><h2>Better together.<span class="heading-dot">*</span></h2></div><div class="testimonial-grid"><figure><span class="quote-mark">“</span><blockquote>They understood the neighbourhood, the customers, and what makes a small business different.</blockquote><figcaption><span class="avatar">R</span><span><strong>Illustrative retail brief</strong><small>Kochi, Kerala · Sample quote</small></span></figcaption></figure><figure><span class="quote-mark">“</span><blockquote>One clear plan for our website, our content, and the enquiries we actually wanted.</blockquote><figcaption><span class="avatar peach">H</span><span><strong>Illustrative hospitality brief</strong><small>Alappuzha, Kerala · Sample quote</small></span></figcaption></figure></div><p class="sample-disclosure">*Illustrative examples, not client endorsements. Verified client stories will be added with permission.</p></section>}
    <section class="faq-section section-shell" id="faq"><div><span class="eyebrow">A FEW ANSWERS</span><h2>Glad you <span class="serif-word">asked.</span></h2><p>Good partnerships start with clear expectations.</p></div><div class="faq-items">{faqs.map((faq,i) => <details name="faq"><summary>{faq.question || faq[0]}<span class="faq-plus">+</span></summary><p>{faq.answer || faq[1]}</p></details>)}</div></section>
    <ContactSection />
  </main>
</SiteLayout>
